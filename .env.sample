# Database Configuration
# In development, this connects to an existing Docker network
DATABASE_URL=postgresql://admin:password@db:5432/menlu_db

# Auth Configuration
NEXTAUTH_SECRET=replaceme_with_a_secure_random_string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional - leave blank to disable Google login)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# Project Settings
COMPOSE_PROJECT_NAME=rm-menlu
PORT=3000
NODE_ENV=development

# Docker Specifics (If using the existing network)
# DOCKER_NETWORK_NAME=existing_network_name

# Deployment (Local machine config)
SSH_KEY_PATH="~/path/to/key"
PROD_PREVIOUS_TAG=1.0.0
PROD_DEPLOY_TAG=1.0.1

# SMTP / Nodemailer
EMAIL_SERVER_USER=user@example.com
EMAIL_SERVER_PASSWORD=secret
EMAIL_FROM="no-reply <user@example.com>"
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587

# Feature Flags
NEXT_PUBLIC_ENABLE_INTEGRATIONS=true
NEXT_PUBLIC_ENABLE_BILLING=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_WALKTHROUGH=true
NEXT_PUBLIC_ENABLE_SCREEN_LOCK=true
NEXT_PUBLIC_ENABLE_OFFLINE=true
NEXT_PUBLIC_ENABLE_AI_CHAT=true

# AI Assistant Configuration
AI_PROVIDER=mock
AI_API_KEY=

# SaaS Platform Payment Gateways (System Subscriptions)
N8N_BILLING_URL=https://n8n.example.com/webhook/billing
ENABLE_BILLING_NOTIFICATIONS=false
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDERS=mock,clip,stripe,mercadopago,pse
CLIP_PUBLIC_KEY=
CLIP_SECRET_KEY=
CLIP_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PSE_SECRET_KEY=
PSE_WEBHOOK_SECRET=




# MonkeyCRM Configuration
RM_CRM_API_KEY="cmrl3g6xapikey"
RM_CRM_BRAND_ID="cmrl1e327000flk?ID"
RM_CRM_CHANNEL_ID=""
RM_CRM_SOURCE="Landing Page"
